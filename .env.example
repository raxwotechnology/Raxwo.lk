# Server Configuration
PORT=5050
NODE_ENV=development

# Database Configuration (MongoDB Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/raxwo
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/raxwo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/raxwo

# Client / CORS Configuration
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5050
