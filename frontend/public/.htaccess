<IfModule LiteSpeed>
    LsRecaptcha 0
    RewriteEngine On
    RewriteRule .* - [E=verifycaptcha:off]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
